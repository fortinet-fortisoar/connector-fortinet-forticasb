{
  "name": "fortinet-forticasb",
  "version": "1.0.0",
  "label": "Fortinet FortiCASB",
  "description": "FortiCASB (Cloud Access Security Broker) is Fortinet’s cloud-native CASB solution, designed for comprehensive visibility, compliance, data security, and threat protection across SaaS and IaaS environments via API integration.",
  "publisher": "Fortinet",
  "icon_small_name": "small_icon.png",
  "icon_large_name": "large_icon.png",
  "cs_approved": true,
  "cs_compatible": true,
  "category": "Cloud access security broker (CASB)",
  "help_online": "",
  "configuration": {
    "fields": [
      {
        "name": "server_url",
        "title": "Server URL",
        "type": "text",
        "editable": true,
        "visible": true,
        "required": true,
        "tooltip": "Specify the URL to which you will connect and perform the automated operations.",
        "description": "Specify the URL of the FortiCASB server to connect and perform the automated operations.",
        "isOnChange": false,
        "onchange": {}
      },
      {
        "name": "api_key",
        "title": "API Key",
        "type": "password",
        "editable": true,
        "visible": true,
        "required": true,
        "tooltip": "Specify the API key that is configured for your account to access the FortiCASB endpoint.",
        "description": "Specify the API key configured for your account to access the FortiCASB endpoint.",
        "isOnChange": false,
        "onchange": {}
      },
      {
        "name": "verify_ssl",
        "title": "Verify SSL",
        "type": "checkbox",
        "editable": true,
        "visible": true,
        "required": false,
        "value": true,
        "tooltip": "Specifies whether the SSL certificate for the server is to be verified or not. By default, this option is set as True.",
        "description": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is selected, i.e., set to true.",
        "isOnChange": false,
        "onchange": {}
      }
    ]
  },
